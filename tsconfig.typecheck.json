{
  // The build config emits from `src` only. This one exists so `npm run typecheck`
  // also covers tests and config files, which would otherwise go unchecked.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
