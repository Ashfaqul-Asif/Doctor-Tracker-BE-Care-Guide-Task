# ---------------------------------------------------------------------------
# Doctor Tracker API — copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- MongoDB Atlas -----------------------------------------------------------
# Atlas > Connect > Drivers. Remember to allowlist your IP under Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=careguide
# Optional. Leave as-is to run tests against the cluster above — they are kept apart by
# MONGODB_DB_NAME_TEST, which is DROPPED between runs and must differ from the name above.
# Only set this if your tests need a different cluster entirely.
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME_TEST=careguide_test

# --- Auth --------------------------------------------------------------------
# There are deliberately NO secrets here. Sessions are opaque random tokens stored as
# SHA-256 hashes in the database — nothing is signed, so there is no key to configure,
# protect or rotate. The only auth setting is how long a session lasts.
SESSION_TTL_DAYS=7

# --- Cookies -----------------------------------------------------------------
# Dev (localhost:3000 -> localhost:4000) is same-site, so `lax` works.
# Cross-domain production requires COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- CORS --------------------------------------------------------------------
# Comma-separated allowlist. Credentials are enabled, so `*` is not permitted.
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting -----------------------------------------------------------
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_MS=900000

# Refresh is throttled far more loosely than login: it is a legitimate background call,
# and one user with several tabs open makes a handful per window without doing anything
# wrong. The ceiling exists to cap a stolen cookie being ground against the endpoint.
REFRESH_RATE_MAX=60
REFRESH_RATE_WINDOW_MS=900000

# --- Dashboard cache ---------------------------------------------------------
CACHE_TTL_SECONDS=120

# --- Seeders -----------------------------------------------------------------
# Seeding is DESTRUCTIVE — each seeder drops its collections before repopulating.
# `npm run seed` refuses to run until this is true, and refuses outright when
# NODE_ENV=production. Check MONGODB_URI before switching it on.
SEED_ENABLED=false

# Inputs to the admin seeder ONLY. The password is bcrypt-hashed into a `users`
# document at seed time; login reads that document, never these variables. Changing
# these has no effect until you re-run the seeder.
SEED_ADMIN_EMAIL=admin@careguide.dev
SEED_ADMIN_PASSWORD=Admin123!

SEED_DOCTORS=200
SEED_PATIENTS=10000
